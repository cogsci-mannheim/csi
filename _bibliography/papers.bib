@incollection{Trips:2026a,
  title = {Derivation},
  booktitle = {The {{Wiley Blackwell Companion}} to {{Diachronic}} and {{Historical Linguistics}}},
  author = {Trips, Carola and Yang, Charles},
  editor = {Ledgeway, Adam and Everaert, Martin and Van Riemsdijk, Henk and Aldridge, Edith and Breitbarth, Anne and Kiss, Katalin and Salmons, Joseph and Simonenko, Alexandra},
  year = 2026,
  month = mar,
  edition = {1},
  pages = {1--28},
  publisher = {Wiley},
  doi = {10.1002/9781119898023.wbcdl083},
  urldate = {2026-04-30},
  abstract = {This chapter deals with derivation and proposes a new approach that brings together research in historical linguistics, acquisition, and learnability. On the assumption that children are the agents of language change, we propose that historical data can be used to reveal processes of learnability in diachrony. The chapter has two parts: in the first part we will discuss a textbook example of diachronic morphology, namely the rise of the suffixes -               hood               , -               dom               , and -               ship               building abstract nouns in English based on Trips. We will present data from Old English, Middle English, and Early Modern English that describe the rise of the three suffixes from the diachronic perspective. This empirical basis serves to answer the following questions: (i) Where does derivational morphology come from? (ii) Are there general stages that define the rise of derivational suffixes? (iii) What triggers the development of these items? In the second part of the chapter we will address the question of how children learn derivational morphology, for example the use of these three suffixes. We will assume that learnability can be calculated on the basis of historical and acquisitional data since both types of data are basically comparable. To do so, we will use Yang's Tolerance Principle (TP) to explain how children test the validity of suffixes, that is, whether a suffix can be used as a productive means to derive new words with a predictable meaning. We will apply the TP to data from contemporary corpora (CELEX) and from historical corpora.},
  copyright = {http://doi.wiley.com/10.1002/tdm\_license\_1.1},
  isbn = {978-1-119-89801-6 978-1-119-89802-3},
  langid = {english}
}

